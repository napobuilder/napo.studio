// ==================================================================
// NAPBAK CONCERT GRAND PIANO - UNIVERSAL SFZ INSTRUMENT
// Compatible with:
// - FL Studio (DirectWave)
// - Ableton Live / Logic Pro / Reaper / Studio One / Cubase
// ==================================================================

<control>
default_path=

<global>
ampeg_attack=0.001
ampeg_decay=4.0
ampeg_sustain=0
ampeg_release=0.8

<group>
<region> sample=Samples/A0.mp3 pitch_keycenter=21 lokey=21 hikey=22
<region> sample=Samples/C1.mp3 pitch_keycenter=24 lokey=23 hikey=25
